<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING"/>

    <application
        android:name="com.captures2024.soongan.SoonGanApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_soongan"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_soongan_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SoonGan"
        tools:targetApi="31"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".SoonGanActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|fontWeightAdjustment|locale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustPan"
            android:theme="@style/Theme.SoonGan"
            android:screenOrientation="portrait">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:foregroundServiceType="remoteMessaging"
            android:name="com.captures2024.soongan.service.FirebaseCloudMessageService"
            android:exported="true"
            android:permission="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_noti_soongan" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.captures2024.soongan.initializer.KakaoSDKInitializer"
                android:value="androidx.startup" />
        </provider>

    </application>

</manifest>
